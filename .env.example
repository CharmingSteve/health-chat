# Copy to .env for local runs only. Never commit .env.
# Use the click AWS profile for every AWS command in this repo.
AWS_PROFILE=click
AWS_REGION=us-east-1

# The single model setting. Must equal the BedrockModel default in infra/template.yaml
# (deploy reads that default so staging and production always use the same model).
# Chosen model (same as stuntman-diet). Cross-region inference profile.
# Alternative to test in the bake-off: amazon.nova-lite-v1:0 (cheaper, read Hebrew better in one test).
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0

# Local data folder (git-ignored) with generated Parquet tables.
DATA_DIR=./data
